{
  "productName": "VIPTV",
  "version": "0.1.0",
  "identifier": "tech.syek.viptv.desktop",
  "build": {
    "beforeDevCommand": "node scripts/frontend.mjs dev",
    "beforeBuildCommand": "node scripts/frontend.mjs build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../tv/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: ws://localhost:* http://localhost:*"
    },
    "windows": [
      {
        "title": "VIPTV",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": { "nsis": { "compression": "zlib" } },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libmpv2", "gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"] },
      "appimage": { "bundleMediaFramework": true }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
